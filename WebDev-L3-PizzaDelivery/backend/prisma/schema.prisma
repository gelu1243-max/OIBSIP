// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("PG_URL")
}
model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  isAdmin   Boolean   @default(false) // separates admin vs user
  isVerified  Boolean  @default(false)
  verificationToken  String?
  resetToken  String?
  resetTokenExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  customPizzas CustomPizza[]
}

model Pizza {
  id          Int       @id @default(autoincrement())
  name        String
  description String?   // Admin-defined description of ingredients
  imageUrl    String?   // Pizza image uploaded by admin
  price       Float
  stock       Int       @default(100)
  threshold   Int       @default(20)
  orderItems  OrderItem[]
}

model PizzaBase {
  id        Int     @id @default(autoincrement())
  name      String
  stock     Int     @default(100)
  threshold Int     @default(20)
  customPizzas CustomPizza[]
}

model Sauce {
  id        Int     @id @default(autoincrement())
  name      String
  stock     Int     @default(100)
  threshold Int     @default(20)
  customPizzas CustomPizza[]
}

model Cheese {
  id        Int     @id @default(autoincrement())
  name      String
  stock     Int     @default(100)
  threshold Int     @default(20)
  customPizzas CustomPizza[]
}

model Vegetable {
  id        Int     @id @default(autoincrement())
  name      String
  stock     Int     @default(100)
  threshold Int     @default(20)
  customPizzas CustomPizza[] @relation("CustomPizzaVegetables")
}

model CustomPizza {
  id          Int         @id @default(autoincrement())
  userId      Int
  createdAt   DateTime    @default(now())
  name        String?     // optional: user can name their pizza
  description String?     // auto-generated summary of chosen ingredients

  user        User        @relation(fields: [userId], references: [id])
  baseId      Int?
  sauceId     Int?
  cheeseId    Int?
  base        PizzaBase?  @relation(fields: [baseId], references: [id])
  sauce       Sauce?      @relation(fields: [sauceId], references: [id])
  cheese      Cheese?     @relation(fields: [cheeseId], references: [id])
  vegetables  Vegetable[] @relation("CustomPizzaVegetables")
  orderItems  OrderItem[]
}
enum OrderStatus {
  RECEIVED
  IN_KITCHEN
  SENT_TO_DELIVERY
  DELIVERED
  CANCELLED
}
enum PaymentStatus{
  PENDING
  SUCCESS
  FAILED
}

model Order {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  status    OrderStatus      @default(RECEIVED) // RECEIVED → IN_KITCHEN → DELIVERY
  totalAmount  Float
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payment   Payment?
}

model OrderItem {
  id          Int        @id @default(autoincrement())
  orderId     Int
  pizzaId     Int?
  customPizzaId Int?
  quantity    Int        @default(1)

  order       Order      @relation(fields: [orderId], references: [id])
  pizza       Pizza?     @relation(fields: [pizzaId], references: [id])
  customPizza CustomPizza? @relation(fields: [customPizzaId], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  amount    Float
  status    PaymentStatus   @default(PENDING) // PENDING → SUCCESS → FAILED
  razorpayId String?

  order     Order    @relation(fields: [orderId], references: [id])
}